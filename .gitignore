# ===== 依赖与本地环境（项目内安装，不入库）=====
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ===== Playwright 浏览器（项目内下载目录）=====
.playwright-browsers/
ms-playwright/

# ===== 构建产物与缓存 =====
dist/
build/
.cache/
coverage/
*.log
logs/

# ===== 临时目录 / 上游克隆暂存 =====
.vendor-src/
.tmp/
.screenshots/
.trae-html-share-packages/

# ===== 密钥与环境变量（公开发布前必须排除）=====
.env
.env.*
!.env.example
.dev.vars
*.pem
*.key

# ===== 重复的二进制副本（目录内已有解包版本）=====
participant-delivery-kit-*.zip

